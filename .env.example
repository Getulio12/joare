# Copie este arquivo para .env somente se usar a API opcional.
# Não adicione credenciais ao Git nem envie tokens pelo chat.
# A importação CSV e o planejamento funcionam sem credenciais.
METRICOOL_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
# Opcional: caminho do banco, porta e interface local
# DATABASE_PATH=data/joare.sqlite
# PORT=3001
# HOST=127.0.0.1

# Somente para hospedar a versão com servidor (não usado no GitHub Pages).
# Gere a senha no painel da hospedagem e mantenha seu valor privado.
# PUBLIC_MODE=true
# APP_PASSWORD=
# APP_ORIGIN=https://seu-dominio.example
